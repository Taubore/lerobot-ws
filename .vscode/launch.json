{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "LeRobot - entraîner ACT dataset pilote",
            "type": "debugpy",
            "request": "launch",
            "module": "lerobot.scripts.lerobot_train",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--dataset.repo_id=${input:datasetRepoId}",
                "--dataset.root=${workspaceFolder}/datasets/${input:datasetRepoId}",
                "--policy.type=act",
                "--output_dir=${workspaceFolder}/outputs/train/${input:datasetRepoId}_${input:stepsEntrainement}",
                "--job_name=act_${input:stepsEntrainement}",
                "--policy.device=cuda",
                "--steps=${input:stepsEntrainement}",
                "--batch_size=8",
                "--save_freq=1000",
                "--log_freq=50",
                "--wandb.enable=false",
                "--policy.push_to_hub=false",
            ]
        },
        {
            "name": "LeRobot - évaluer ACT dataset pilote",
            "type": "debugpy",
            "request": "launch",
            "module": "lerobot.scripts.lerobot_rollout",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--strategy.type=base",
                "--policy.path=${workspaceFolder}/outputs/train/${input:datasetRepoId}_${input:stepsEntrainement}/checkpoints/last/pretrained_model",
                "--robot.type=so101_follower",
                "--robot.port=/dev/ttyACM1",
                "--robot.id=bras_suiveur",
                "--robot.cameras={globale: {type: opencv, index_or_path: /dev/video2, width: 1280, height: 720, fps: 30, fourcc: MJPG}}",
                "--task=Prendre le cube noir et le déposer dans le carré beige.",
                "--duration=15",
                "--display_data=false",
            ]
        }
    ],
    "inputs": [
        {
            "id": "datasetRepoId",
            "type": "promptString",
            "description": "Identifiant du dataset Hugging Face",
            "default": "taubore/deplacer_cube_v01"
        },
        {
            "id": "stepsEntrainement",
            "type": "promptString",
            "description": "Nombre d'étapes d'entraînement",
            "default": "5000"
        }
    ]
}
